$ go mod init example
$ go build -o counter .
$ ./counter 2 >/dev/null
exit status 0, race report: no
$ go build -race -o counter_race .
$ ./counter_race 1 >/dev/null
exit status 0, race report: no
$ ./counter_race 2 >/dev/null
exit status 66, race report: yes
