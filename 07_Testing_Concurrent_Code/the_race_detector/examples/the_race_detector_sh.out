  counter.go:20  wg.Go(func() {
  counter.go:22  orders++ // read, add one, write back: no lock
$ GOMAXPROCS=1 ./counter_race 2 >/dev/null
exit status 66, race report: yes
$ go run -race . 2 >/dev/null
exit status 1, race report: yes
