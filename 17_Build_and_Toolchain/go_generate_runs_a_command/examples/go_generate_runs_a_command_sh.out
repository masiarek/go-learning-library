$ go build -o orders .
# example
./main.go:7:25: s.String undefined (type Status has no field or method String)
exit status 1
$ go generate -x ./...
go run ./gen
exit status 0
$ cat status_string.go
// Code generated by gen from status.go:3; DO NOT EDIT.

package main

import "fmt"

func (s Status) String() string {
	switch s {
	case Pending:
		return "Pending"
	case Paid:
		return "Paid"
	case Shipped:
		return "Shipped"
	case Cancelled:
		return "Cancelled"
	}
	return fmt.Sprintf("Status(%d)", int(s))
}
$ gofmt -l status_string.go
$ go build -o orders . && ./orders
0 Pending
1 Paid
2 Shipped
3 Cancelled
4 Status(4)
