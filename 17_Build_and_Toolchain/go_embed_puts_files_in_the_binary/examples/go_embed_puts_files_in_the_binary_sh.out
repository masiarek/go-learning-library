mailer
$ ./mailer
version: "1.4.2\n"
logo: 6 bytes, 89 50 4e 47 0d 0a
ReadDir: cancelled.txt
ReadDir: shipped.txt
WalkDir: . dir=true
WalkDir: templates dir=true
WalkDir: templates/emails dir=true
